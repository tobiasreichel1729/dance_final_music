            </intent-filter>
        </activity>
        <activity android:name=".DanceStyleActivity" />
        <activity android:name=".DanceSelectActivity" />
        <activity android:name=".MusicTimingActivity" />
        <activity android:name=".BurstSettingsActivity" />
        <activity android:name=".DanceTimerActivity" />
