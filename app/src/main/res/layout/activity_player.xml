<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="20dp">

    <!-- Header -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp">

        <ImageView
            android:id="@+id/backBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/circle_bg"
            android:padding="8dp"
            android:src="@drawable/ic_back"
            android:scaleType="fitCenter"
            android:contentDescription="Back" />

        <TextView
            android:id="@+id/headerTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Wiedergabe"
            android:textColor="@color/textOnDark"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/overflowBtn"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/circle_bg"
            android:padding="8dp"
            android:src="@drawable/ic_more_vert"
            android:scaleType="fitCenter"
            android:contentDescription="Optionen"
            android:clickable="true"
            android:focusable="true" />

    </FrameLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="@color/divider" />

    <!-- Spacer top -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Album art: quadratic, floating -->
    <ImageView
        android:id="@+id/albumArt"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/player_art_placeholder"
        android:clipToOutline="true"
        android:elevation="14dp"
        android:scaleType="centerCrop"
        android:contentDescription="Album art" />

    <!-- Spacer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="0.6" />

    <!-- Song title -->
    <TextView
        android:id="@+id/songTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Titel"
        android:textColor="@color/textOnDark"
        android:textSize="22sp"
        android:textStyle="bold" />

    <!-- BPM / speed subtitle -->
    <TextView
        android:id="@+id/songSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="@color/textSecondaryOnDark"
        android:textSize="15sp" />

    <!-- Spacer -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Progress -->
    <SeekBar
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:max="1000"
        android:progress="0"
        android:progressTint="@color/accent"
        android:thumbTint="@color/accent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/currentTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="0:00"
            android:textColor="@color/textSecondaryOnDark"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/totalTime"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="end"
            android:text="0:00"
            android:textColor="@color/textSecondaryOnDark"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Controls -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical|center_horizontal"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/prevBtn"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginEnd="32dp"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_previous"
            android:contentDescription="Zurück" />

        <ImageButton
            android:id="@+id/playPauseBtn"
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/circle_bg"
            android:scaleType="fitCenter"
            android:padding="20dp"
            android:src="@drawable/ic_play"
            android:contentDescription="Play" />

        <ImageButton
            android:id="@+id/nextBtn"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="32dp"
            android:background="@android:color/transparent"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_skip_next"
            android:contentDescription="Weiter" />

    </LinearLayout>

    <!-- Queue button -->
    <Button
        android:id="@+id/queueBtn"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="Warteschlange"
        android:textSize="14sp"
        android:textAllCaps="false" />

    <!-- Spacer bottom -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="24dp" />

</LinearLayout>
